# ============================================================================
# Antigravity OS — repo .gitignore
# Sensitive personal state and runtime artifacts must never be committed.
# ============================================================================

# --- Personal/runtime state ---
# Contains your actual goals, activity, notes, subscriptions. Use the
# .example versions as templates.
shared/goals.json
shared/subscriptions.json
shared/notes.md
shared/activity-log.md
shared/hermes-state.md

# Search Console pulls — regenerated by the crons before every run, so tracking
# them would be pure churn. Produced by ~/.hermes/scripts/{hf_gsc_report,
# hf_gsc_worklist,leadgen_gsc_report}.py.
shared/hf-gsc-latest.json
shared/hf-gsc-worklist.md
shared/leadgen-gsc-latest.md

# --- Claude Code workspace settings ---
# .claude/settings.local.json embeds API tokens in command patterns.
# .claude/ also contains session caches.
.claude/

# --- Antigravity IDE project marker ---
.antigravitycli/

# --- Node / Next.js build artifacts (also handled inside mission-control/.gitignore) ---
node_modules/
.next/
out/

# --- Env files ---
.env
.env.local
.env.*.local
*.env

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.log

# --- Bun caches ---
.bun/

# Personal Ralph PRDs + run state
ralphs/
